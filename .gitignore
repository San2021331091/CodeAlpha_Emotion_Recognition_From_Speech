ml-service/.logs/
*.pid
*.seed
*.pid.lock

# ------------------------------------------------------------------------------
# 6. Large Datasets & Raw Audio Files (Exceeds GitHub Limits & Licensing Terms)
# ------------------------------------------------------------------------------
# Downloaded multi-corpus audio datasets (RAVDESS: ~760MB, TESS: ~270MB, EMO-DB: ~46MB)
ml-service/data/ravdess/
ml-service/data/tess/
ml-service/data/emo-db/

# Augmented & synthetic audio training corpora (training_50000: ~7.2GB)
ml-service/data/training_*/
ml-service/data/training_50000/
ml-service/data/training_balanced/
ml-service/data/training_regenerated_v2/

# General audio files in data directories
ml-service/data/**/*.wav
ml-service/data/**/*.mp3
ml-service/data/**/*.flac
ml-service/data/**/*.ogg
ml-service/data/**/*.m4a

# Keep the lightweight benchmark validation samples for testing & demos
!ml-service/data/audio_samples/
!ml-service/data/audio_samples/**
!ml-service/data/audio_samples/benchmark/*.wav
!ml-service/data/benchmark_manifest.json

# ------------------------------------------------------------------------------
# 7. Heavy Extracted Feature Arrays & Feature Caches
# ------------------------------------------------------------------------------
*.npz
*.npy
ml-service/data/*.npz
ml-service/data/*.npy
ml-service/data/cached_features.npz
ml-service/data/multicorpus_features_*.npz
ml-service/data/ravdess_features_*.npz
ml-service/data/wavlm_features_*.npy
ml-service/data/wavlm_features_*.json

# ------------------------------------------------------------------------------
# 8. Pretrained Model Weights, Cache & Large Deep Learning Binaries (>100MB)
# ------------------------------------------------------------------------------
# Hugging Face / Transformers local WavLM cache (~720MB)
.model_cache/
ml-service/.model_cache/

# Heavy neural network weight checkpoints
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.h5
*.onnx
*.weights

# Intermediate / experimental training staging directories
ml-service/saved_models_*/
saved_models_*/

# Runtime ML job state & diagnostic records
ml-service/last_inference_diagnostic.json
ml-service/training_job.json

# Model Binaries Note:
# The deployed models in ml-service/saved_models/ (~49MB total) are tracked so the
# application can be cloned and run immediately without retraining.
# If you prefer to exclude all serialized .joblib models, uncomment the lines below:
# ml-service/saved_models/*.joblib
# !ml-service/saved_models/metrics.json

